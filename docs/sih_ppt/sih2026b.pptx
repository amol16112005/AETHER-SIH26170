            <a href="https://www.instagram.com/blinknbuildyt" target="_blank" rel="noopener noreferrer" class="social-icon-link" title="Instagram" aria-label="BlinkNBuild on Instagram"><i class="fab fa-instagram"></i></a>
          </div>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">Quick Links</h4>
          <ul class="footer-links-list">
            <li class="footer-link-item"><a href="/">Home Base</a></li>
            <li class="footer-link-item"><a href="/courses/">Hardware Academy</a></li>
            <li class="footer-link-item"><a href="/gate/ece/">GATE ECE Portal</a></li>
            <li class="footer-link-item"><a href="/sih">SIH 2026 Master Hub</a></li>
            <li class="footer-link-item"><a href="/#projects">Featured Projects</a></li>
            <li class="footer-link-item"><a href="/tools/">Tools Hub</a></li>
            <li class="footer-link-item"><a href="/games/">Games Arcade</a></li>
            <li class="footer-link-item"><a href="/about.html">About Us</a></li>
            <li class="footer-link-item"><a href="/contact.html">Contact</a></li>
            <li class="footer-link-item"><a href="/terms.html">Terms of Service</a></li>
            <li class="footer-link-item"><a href="/privacy-policy.html">Privacy Policy</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">SIH 2026 Downloads</h4>
          <ul class="footer-links-list">
            <li class="footer-link-item"><a href="/Assets/SIH_2026_All_Problem_Statements_Master_Catalogue.pdf" download><i class="fas fa-file-pdf" style="color: var(--gold-400); margin-right: 6px;"></i>Download Master PDF (236 PS)</a></li>
            <li class="footer-link-item"><a href="/Assets/SIH_2026_Quick_Reference_Problem_Statements_Compilation.pdf" download><i class="fas fa-bolt" style="color: var(--cyan-400); margin-right: 6px;"></i>Download Compact PS (27 Pages)</a></li>
            <li class="footer-link-item"><a href="/Assets/SIH2026-IDEA-Presentation-Format.pptx" download><i class="fas fa-file-powerpoint" style="color: var(--cyan-400); margin-right: 6px;"></i>Download Official PPT Template</a></li>
            <li class="footer-link-item"><a href="https://sih.gov.in" target="_blank" rel="noopener noreferrer"><i class="fas fa-external-link-alt" style="margin-right: 6px;"></i>Official SIH Portal</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4 class="footer-col-title">Contact</h4>
          <ul class="contact-info-list">
            <li><i class="fas fa-envelope contact-icon"></i> blinknbuildyt@gmail.com</li>
            <li><i class="fas fa-map-marker-alt contact-icon"></i> Bengaluru, India</li>
            <li style="margin-top: 10px; color: var(--neutral-600); font-size: 12px; line-height: 1.4;">
              <i class="fas fa-handshake contact-icon"></i> Collabs & Sponsorships Open
            </li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <span class="copyright-text">© 2026 BlinkNBuild. Open Source.</span>
        <span class="credit-text">Built with solder, code, and a blink of an <span class="blink-led">LED</span><span class="led-dot"></span></span>
      </div>
      <div style="font-size: 11.5px; color: var(--neutral-600); line-height: 1.6; margin-top: 16px; border-top: 1px solid rgba(255,255,255,0.06); padding-top: 12px; text-align: center;">
        All company, brand, and product names referenced on BlinkNBuild (including Qualcomm, Intel, NVIDIA, Apple, AMD, Arm, Synopsys, Cadence, Xilinx, Texas Instruments, Arduino, Espressif, and Raspberry Pi) are trademarks or registered trademarks of their respective holders. Use of these names does not imply affiliation, sponsorship, or endorsement. BlinkNBuild is an independent maker and educational initiative.
      </div>

    </div>
  </footer>

  <script src="/hero-canvas.js" defer></script>
  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      let psData = [];
      const container = document.getElementById('ps-container');
      const searchInput = document.getElementById('sih-search');
      const categoryFilter = document.getElementById('sih-category-filter');
      const themeFilter = document.getElementById('sih-theme-filter');
      const countLabel = document.getElementById('ps-result-count');

      // The explorer needs all four nodes; without them every handler below
      // would throw on a null reference and take the rest of the page with it.
      if (!container || !searchInput || !categoryFilter || !themeFilter) {
        console.warn('SIH explorer markup incomplete - interactive filter disabled.');
        return;
      }

      // 3-Second Wait Time Download Modal Elements
      const modal = document.getElementById('download-timer-modal');
      const modalCloseBtn = document.getElementById('modal-close-btn');
      const modalFileName = document.getElementById('modal-file-name');
      const modalFileMeta = document.getElementById('modal-file-meta');
      const modalFileIcon = document.getElementById('modal-file-icon');
      const modalTimerPill = document.getElementById('timer-sec-pill');
      const modalStatusText = document.getElementById('timer-status-text');
      const modalProgressBar = document.getElementById('modal-progress-bar');
      const modalActionBtn = document.getElementById('modal-action-btn');
      const modalSubtext = document.getElementById('modal-subtext');

      let downloadTimerInterval = null;
      let activeDownloadUrl = '';
      let activeFileName = '';

      function openDownloadModal(url, filename, type) {
        activeDownloadUrl = url;
        activeFileName = filename;
        modalFileName.textContent = filename;

        if (type === 'pdf') {
          modalFileIcon.innerHTML = '<i class="fas fa-file-pdf"></i>';
          modalFileIcon.style.color = 'var(--gold-400)';
          modalFileMeta.textContent = 'Official SIH 2026 Master Catalogue · 231 Pages · Verified: 07 Sep 2026 · PDF';
        } else if (type === 'compact') {
          modalFileIcon.innerHTML = '<i class="fas fa-bolt"></i>';
          modalFileIcon.style.color = 'var(--cyan-400)';
          modalFileMeta.textContent = 'SIH 2026 Quick-Reference Compilation · 27 Pages · Verified: 07 Sep 2026 · Fast PDF';
        } else {
          modalFileIcon.innerHTML = '<i class="fas fa-file-powerpoint"></i>';
          modalFileIcon.style.color = 'var(--cyan-400)';
          modalFileMeta.textContent = 'Official AICTE 6-Slide Idea Presentation Format · .PPTX Template';
        }

        // Reset state
        modalTimerPill.textContent = '5s';
        modalStatusText.textContent = 'Preparing High-Speed Download Link (5s)...';
        modalProgressBar.style.width = '0%';
        modalActionBtn.className = 'btn-modal-download disabled';
        modalActionBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating Download Link (5s)...';
        modalActionBtn.onclick = null;
        modalSubtext.textContent = 'Your direct download will begin automatically when the timer completes.';

        modal.style.display = 'flex';
        setTimeout(() => modal.classList.add('active'), 10);

        if (downloadTimerInterval) clearInterval(downloadTimerInterval);

        const startTime = Date.now();
        const duration = 5000; // 5 seconds

        downloadTimerInterval = setInterval(() => {
          const elapsed = Date.now() - startTime;
          const progress = Math.min(100, (elapsed / duration) * 100);
          modalProgressBar.style.width = `${progress}%`;

          const remainingSeconds = Math.max(0, Math.ceil((duration - elapsed) / 1000));
          if (remainingSeconds > 0) {
            modalTimerPill.textContent = `${remainingSeconds}s`;
            modalActionBtn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Generating Download Link (${remainingSeconds}s)...`;
          }

          if (elapsed >= duration) {
            clearInterval(downloadTimerInterval);
            modalProgressBar.style.width = '100%';
            modalTimerPill.textContent = 'Ready!';
            modalStatusText.textContent = 'Download Link Ready & Verified!';
            modalActionBtn.className = 'btn-modal-download ready';
            modalActionBtn.innerHTML = '<i class="fas fa-check-circle"></i> Download Started (Click if not started)';
            
            modalActionBtn.onclick = () => {
              triggerDirectDownload(activeDownloadUrl, activeFileName);
            };

            modalSubtext.textContent = 'Your download has been triggered automatically. Click the green button above if it did not start.';

            // Auto trigger download
            triggerDirectDownload(activeDownloadUrl, activeFileName);

            if (window.logFirebaseEvent) {
              window.logFirebaseEvent('file_download', {
                file_name: activeFileName,
                link_url: activeDownloadUrl,
                wait_time_seconds: 5
              });
              window.logFirebaseEvent('download_timer_complete', {
                file_name: activeFileName
              });
            }
          }
        }, 100);
      }

      function triggerDirectDownload(url, filename) {
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      }

      function closeModal() {
        modal.classList.remove('active');
        if (downloadTimerInterval) clearInterval(downloadTimerInterval);
        setTimeout(() => {
          modal.style.display = 'none';
        }, 250);
      }

      modalCloseBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      // Bind all download buttons on page
      function bindDownloadButtons() {
        document.querySelectorAll('.btn-download-pdf, a[href*="Problem_Statements_Master_Catalogue.pdf"]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            openDownloadModal(
              '/Assets/SIH_2026_All_Problem_Statements_Master_Catalogue.pdf',
              'SIH_2026_All_236_Problem_Statements_Master_Catalogue.pdf',
              'pdf'
            );
          });
        });

        document.querySelectorAll('.btn-download-compact, a[href*="Quick_Reference_Problem_Statements_Compilation.pdf"]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            openDownloadModal(
              '/Assets/SIH_2026_Quick_Reference_Problem_Statements_Compilation.pdf',
              'SIH_2026_Quick_Reference_Problem_Statements_Compilation.pdf',
              'compact'
            );
          });
        });

        document.querySelectorAll('.btn-download-ppt, a[href*="Presentation-Format.pptx"]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            openDownloadModal(
              '/Assets/SIH2026-IDEA-Presentation-Format.pptx',
              'SIH2026-IDEA-Presentation-Format.pptx',
              'ppt'
            );
          });
        });
      }

      // Check for incoming download parameter from YouTube (e.g. ?download=pdf, ?download=ppt, ?download=compact)
      function checkIncomingDownloadParam() {
        const params = new URLSearchParams(window.location.search);
        const dl = params.get('download');
        if (!dl) return;
        
        setTimeout(() => {
          if (dl === 'pdf' || dl === 'master') {
            openDownloadModal(
              '/Assets/SIH_2026_All_Problem_Statements_Master_Catalogue.pdf',
              'SIH_2026_All_236_Problem_Statements_Master_Catalogue.pdf',
              'pdf'
            );
          } else if (dl === 'compact') {
            openDownloadModal(
              '/Assets/SIH_2026_Quick_Reference_Problem_Statements_Compilation.pdf',
              'SIH_2026_Quick_Reference_Problem_Statements_Compilation.pdf',
              'compact'
            );
          } else if (dl === 'ppt') {
            openDownloadModal(
              '/Assets/SIH2026-IDEA-Presentation-Format.pptx',
              'SIH2026-IDEA-Presentation-Format.pptx',
              'ppt'
            );
          }
        }, 400);
      }

      try {
        const res = await fetch('/Assets/sih_2026_problem_statements.json?v=236_07sep2026', { cache: 'no-cache' });
        psData = await res.json();
        populateThemes(psData);
        renderPS();
        bindDownloadButtons();
        checkIncomingDownloadParam();
      } catch (err) {
        console.error('Error loading SIH JSON:', err);
        container.innerHTML = '<div style="text-align:center; padding:30px; color:var(--gold-400);">Could not load dynamic problem statements. Please use the direct Download PDF button above.</div>';
        bindDownloadButtons();
        checkIncomingDownloadParam();
      }

      function populateThemes(data) {
        const themes = new Set();
        data.forEach(item => {
          if (item.theme && item.theme.trim()) {
            themes.add(item.theme.trim());
          }
        });
        if (!themeFilter) return;
        const sortedThemes = Array.from(themes).sort();
        themeFilter.innerHTML = '<option value="all">All Themes (' + sortedThemes.length + ')</option>';
        sortedThemes.forEach(t => {
          const opt = document.createElement('option');
          opt.value = t;
          opt.textContent = t;
          themeFilter.appendChild(opt);
        });
      }

      function renderPS() {
        const query = searchInput.value.toLowerCase().trim();
        const selectedCat = categoryFilter.value;
        const selectedTheme = themeFilter.value;

        const filtered = psData.filter(item => {
          const matchesCat = selectedCat === 'all' || (item.category && item.category.toLowerCase() === selectedCat.toLowerCase());
          const matchesTheme = selectedTheme === 'all' || (item.theme && item.theme.toLowerCase() === selectedTheme.toLowerCase());
          
          const codeMatch = item.ps_code && item.ps_code.toLowerCase().includes(query);
          const titleMatch = item.title && item.title.toLowerCase().includes(query);
          const orgMatch = item.organization && item.organization.toLowerCase().includes(query);
          const detailsMatch = (item.details || item.description) && (item.details || item.description).toLowerCase().includes(query);

          return matchesCat && matchesTheme && (query === '' || codeMatch || titleMatch || orgMatch || detailsMatch);
        });

        countLabel.textContent = `Showing ${filtered.length} of ${psData.length} Problem Statements`;

        if (filtered.length === 0) {
          container.innerHTML = `
            <div style="text-align: center; padding: var(--sp-10); background: var(--bg-surface); border: 1px dashed var(--border-soft); border-radius: var(--r-lg);">
              <i class="fas fa-search" style="font-size: 32px; color: var(--neutral-600); margin-bottom: 10px;"></i>
              <p style="color: var(--neutral-800); font-family: 'Exo 2', sans-serif;">No problem statements matched your search criteria.</p>
            </div>
          `;
          return;
        }

        // Safe HTML sanitizer
        function escapeHtml(str) {
          if (!str) return '';
          return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
        }

        container.innerHTML = '';
        filtered.forEach((item, i) => {
          const card = document.createElement('div');
          card.className = 'ps-card';
          
          const catClass = (item.category || '').toLowerCase().includes('hard') ? 'hardware' : 'software';
          const catLabel = escapeHtml(item.category || 'Software');
          const safeCode = escapeHtml(item.ps_code || ('SIH26' + (item.index || i+1)));
          const safeTitle = escapeHtml(item.title || '');
          const safeOrg = escapeHtml(item.organization || 'Government of India');
          const safeTheme = escapeHtml(item.theme || 'General Innovation');
          const rawDetails = item.details || item.description || 'Please refer to the official Master PDF catalogue for detailed requirements.';
          const safeDetails = escapeHtml(rawDetails);
          const safeIndex = parseInt(item.index || i+1, 10);

          card.innerHTML = `
            <div class="ps-header">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span class="ps-code-badge">${safeCode}</span>
                <span class="ps-category-badge ${catClass}">${catLabel}</span>
              </div>
              <span style="font-size: 12px; color: var(--neutral-700); font-family: 'JetBrains Mono', monospace;">#${safeIndex} of ${psData.length}</span>
            </div>

            <h3 class="ps-title">${safeTitle}</h3>

            <div class="ps-meta-row">
              <div class="ps-meta-item"><i class="fas fa-building"></i> <span>${safeOrg}</span></div>
              <div class="ps-meta-item"><i class="fas fa-tag"></i> <span>${safeTheme}</span></div>
            </div>

            <button class="ps-details-toggle" id="btn-toggle-${safeIndex}">
              <i class="fas fa-chevron-down" id="icon-toggle-${safeIndex}"></i> View Detailed Problem Statement & Requirements
            </button>

            <div class="ps-details-body" id="details-${safeIndex}">
              ${safeDetails}
            </div>
          `;

          container.appendChild(card);

          // Add toggle event
          const toggleBtn = card.querySelector('.ps-details-toggle');
          const detailsBody = card.querySelector('.ps-details-body');
          const toggleIcon = toggleBtn ? toggleBtn.querySelector('i') : null;

          if (!toggleBtn || !detailsBody || !toggleIcon) return;
          toggleBtn.setAttribute('aria-expanded', 'false');

          toggleBtn.addEventListener('click', () => {
            const isOpen = detailsBody.classList.toggle('open');
            toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            if (isOpen) {
              toggleIcon.className = 'fas fa-chevron-up';
              toggleBtn.style.color = 'var(--gold-400)';
              if (window.logFirebaseEvent) {
                window.logFirebaseEvent('view_item', {
                  item_id: safeCode,
                  item_name: safeTitle,
                  item_category: catLabel,
                  organization: safeOrg,
                  theme: safeTheme
                });
                window.logFirebaseEvent('sih_view_details', {
                  ps_code: safeCode,
                  title: safeTitle,
                  category: catLabel
                });
              }
            } else {
              toggleIcon.className = 'fas fa-chevron-down';
              toggleBtn.style.color = 'var(--cyan-400)';
            }
          });
        });
      }

      let sihSearchDebounce;
      searchInput.addEventListener('input', () => {
        renderPS();
        clearTimeout(sihSearchDebounce);
        if (window.logFirebaseEvent && searchInput.value.length > 2) {
          sihSearchDebounce = setTimeout(() => {
            window.logFirebaseEvent('search', {
              search_term: searchInput.value,
              search_category: 'sih_problem_statements'
            });
            window.logFirebaseEvent('sih_search', { query: searchInput.value });
          }, 500);
        }
      });

      categoryFilter.addEventListener('change', () => {
        renderPS();
        if (window.logFirebaseEvent) {
          window.logFirebaseEvent('select_content', {
            content_type: 'sih_category_filter',
            item_id: categoryFilter.value
          });
          window.logFirebaseEvent('sih_filter_category', { category: categoryFilter.value });
        }
      });

      themeFilter.addEventListener('change', () => {
        renderPS();
        if (window.logFirebaseEvent) {
          window.logFirebaseEvent('select_content', {
            content_type: 'sih_theme_filter',
            item_id: themeFilter.value
          });
          window.logFirebaseEvent('sih_filter_theme', { theme: themeFilter.value });
        }
      });

      // Scroll Depth Tracking on SIH Hub
      const sihScrollThresholds = [25, 50, 75, 90];
      const sihTriggeredScrolls = {};
      window.addEventListener('scroll', () => {
        const totalScroll = document.documentElement.scrollHeight - window.innerHeight;
        if (totalScroll <= 0) return;
        const scrollPercent = Math.round((window.scrollY / totalScroll) * 100);
        sihScrollThresholds.forEach(t => {
          if (scrollPercent >= t && !sihTriggeredScrolls[t]) {
            sihTriggeredScrolls[t] = true;
            if (window.logFirebaseEvent) {
              window.logFirebaseEvent('scroll', { percent_scrolled: t });
              window.logFirebaseEvent('scroll_depth', { depth: t, page: 'sih' });
            }
          }
        });
      }, { passive: true });
    });
  </script>
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495" integrity="sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==" data-cf-beacon='{"version":"2024.11.0","token":"6e7a072e48104256aaaef358514a1197","r":1,"spa":2}' crossorigin="anonymous"></script>
</body>
</html>
