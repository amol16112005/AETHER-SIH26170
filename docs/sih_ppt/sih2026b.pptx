  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart India Hackathon 2026 (SIH) : All 236 Problem Statements & Master PDF | BlinkNBuild</title>
  <meta name="description" content="Explore and search all 236 official Smart India Hackathon 2026 Problem Statements. Download the Master Catalogue PDF, official PPT template, and watch video breakdown guides.">
  <meta name="keywords" content="Smart India Hackathon 2026, SIH 2026, SIH Problem Statements, SIH 2026 PS PDF, SIH PPT Template, AICTE, BlinkNBuild">
  <link rel="canonical" href="https://blinknbuild.in/sih">

  <!-- Open Graph -->
  <meta property="og:title" content="SIH 2026: All 236 Problem Statements & Master PDF | BlinkNBuild">
  <meta property="og:description" content="Search all 236 SIH 2026 Problem Statements by Ministry, Theme, or Category. Download the official Master PDF and PPT template.">
  <meta property="og:image" content="https://blinknbuild.in/Assets/blinknbuild-logo.png">
  <meta property="og:url" content="https://blinknbuild.in/sih">
  <meta property="og:type" content="website">

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Exo+2:ital,wght@0,300;0,400;0,600;0,700;0,900;1,400&family=JetBrains+Mono:wght@400;600;700&family=Orbitron:wght@400;700;900&display=swap">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin>
  <link rel="dns-prefetch" href="https://googleads.g.doubleclick.net">
  <link rel="stylesheet" href="/style.css?v=20260908_v3">

  <style>
    /* Nav Actions Spacing Fix */
    .nav-actions {
      display: flex !important;
      align-items: center !important;
      gap: 14px !important;
    }
    /* SIH Hub Specific Styles */
    .sih-hero {
      padding: 130px 0 var(--sp-12);
      position: relative;
      overflow: hidden;
      background: radial-gradient(circle at 50% 20%, rgba(0, 212, 245, 0.08) 0%, rgba(10, 14, 26, 0.95) 75%);
    }
    .sih-badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      border-radius: 999px;
      background: rgba(245, 166, 35, 0.12);
      border: 1px solid rgba(245, 166, 35, 0.35);
      color: var(--gold-400);
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: var(--sp-4);
    }
    .sih-title {
      font-family: 'Orbitron', sans-serif;
      font-size: clamp(28px, 5.5vw, 52px);
      font-weight: 900;
      color: #fff;
      line-height: 1.15;
      margin-bottom: var(--sp-4);
      letter-spacing: -0.02em;
    }
    .sih-title span {
      color: var(--cyan-400);
      text-shadow: 0 0 25px rgba(0, 212, 245, 0.4);
    }
    .sih-subtitle {
      font-size: clamp(15px, 2vw, 18px);
      color: var(--neutral-800);
      max-width: 820px;
      margin: 0 auto var(--sp-8);
      line-height: 1.6;
    }
    .sih-metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: var(--sp-4);
      max-width: 960px;
      margin: 0 auto var(--sp-8);
    }
    .sih-metric-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--r-lg);
      padding: var(--sp-4) var(--sp-5);
      text-align: center;
      transition: var(--trans-default);
    }
    .sih-metric-card:hover {
      border-color: var(--cyan-400);
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0, 212, 245, 0.15);
    }
    .sih-metric-val {
      font-family: 'Orbitron', sans-serif;
      font-size: 26px;
      font-weight: 700;
      color: var(--cyan-400);
      margin-bottom: 4px;
    }
    .sih-metric-label {
      font-size: 13px;
      color: var(--neutral-700);
      font-family: 'Exo 2', sans-serif;
    }
    .sih-cta-group {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--sp-4);
      margin-bottom: var(--sp-6);
    }
    .btn-download-pdf {
      background: linear-gradient(135deg, var(--gold-400) 0%, var(--gold-500) 100%);
      color: #050e2c;
      font-weight: 700;
      padding: 14px 28px;
      font-size: 16px;
      border-radius: var(--r-md);
      box-shadow: 0 0 25px rgba(245, 166, 35, 0.4);
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      transition: var(--trans-default);
    }
    .btn-download-pdf:hover {
      transform: translateY(-3px);
      box-shadow: 0 0 35px rgba(245, 166, 35, 0.6);
      color: #000;
    }
    
    .btn-download-compact {
      background: linear-gradient(135deg, rgba(0, 212, 245, 0.15) 0%, rgba(30, 64, 175, 0.25) 100%);
      color: #fff;
      border: 1.5px solid var(--cyan-400);
      font-weight: 700;
      padding: 14px 26px;
      font-size: 15px;
      border-radius: var(--r-md);
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      cursor: pointer;
      box-shadow: 0 0 20px rgba(0, 212, 245, 0.25);
      transition: var(--trans-default);
    }
    .btn-download-compact:hover {
      background: var(--cyan-400);
      color: #050e2c;
      transform: translateY(-3px);
      box-shadow: 0 0 30px rgba(0, 212, 245, 0.5);
    }

    .btn-download-ppt {
      background: rgba(0, 212, 245, 0.1);
      color: var(--cyan-400);
      border: 1px solid var(--cyan-400);
      font-weight: 600;
      padding: 14px 26px;
      font-size: 15px;
      border-radius: var(--r-md);
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      transition: var(--trans-default);
    }
    .btn-download-ppt:hover {
      background: var(--cyan-400);
      color: #050e2c;
      box-shadow: 0 0 25px rgba(0, 212, 245, 0.4);
      transform: translateY(-3px);
    }

    /* Video section */
    .sih-featured-video {
      background: var(--bg-surface);
      border: 1.5px solid rgba(0, 212, 245, 0.3);
      border-radius: var(--r-xl);
      padding: var(--sp-6);
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: var(--sp-6);
      align-items: center;
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4), 0 0 20px rgba(0, 212, 245, 0.08);
      margin-top: var(--sp-6);
      margin-bottom: var(--sp-8);
      transition: var(--trans-default);
    }
    .sih-featured-video:hover {
      border-color: var(--cyan-400);
      box-shadow: 0 16px 45px rgba(0, 0, 0, 0.5), 0 0 30px rgba(0, 212, 245, 0.2);
    }
    @media (max-width: 900px) {
      .sih-featured-video {
        grid-template-columns: 1fr;
      }
    }
    .sih-videos-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-6);
    }
    @media (max-width: 1024px) {
      .sih-videos-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (max-width: 640px) {
      .sih-videos-grid {
        grid-template-columns: 1fr;
      }
    }
    .sih-video-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--r-lg);
      padding: var(--sp-5);
      display: flex;
      flex-direction: column;
      gap: var(--sp-3);
      transition: var(--trans-default);
    }
    .sih-video-card:hover {
      border-color: var(--cyan-400);
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }
    .sih-video-iframe-wrap {
      position: relative;
      width: 100%;
      padding-bottom: 56.25%;
      border-radius: var(--r-md);
      overflow: hidden;
      background: #000;
      border: 1px solid var(--border-soft);
    }
    .sih-video-iframe-wrap iframe {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      border: 0;
    }

    /* PS Search Section */
    .ps-controls {
      background: var(--bg-surface);
      border: 1px solid var(--border-soft);
      border-radius: var(--r-xl);
      padding: var(--sp-6);
      margin-bottom: var(--sp-8);
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--sp-4);
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
    @media (max-width: 900px) {
      .ps-controls {
        grid-template-columns: 1fr;
      }
    }
    .ps-search-input {
      width: 100%;
      background: var(--neutral-100);
      border: 1px solid var(--border-soft);
      border-radius: var(--r-md);
      padding: 12px 16px;
      color: #fff;
      font-size: 14.5px;
      font-family: 'DM Sans', sans-serif;
      outline: none;
      transition: var(--trans-default);
    }
    .ps-search-input:focus {
      border-color: var(--cyan-400);
      box-shadow: 0 0 12px rgba(0, 212, 245, 0.25);
    }
    .ps-select {
      background: var(--neutral-100);
      border: 1px solid var(--border-soft);
      border-radius: var(--r-md);
      padding: 12px 14px;
      color: #fff;
      font-size: 14px;
      font-family: 'DM Sans', sans-serif;
      outline: none;
      cursor: pointer;
    }
    .ps-select:focus {
      border-color: var(--cyan-400);
    }

    /* Problem Statements List */
    .ps-count-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--sp-4);
      color: var(--neutral-700);
      font-size: 14px;
      font-family: 'Exo 2', sans-serif;
    }
    .ps-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }
    .ps-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--r-lg);
      padding: var(--sp-6);
      transition: var(--trans-default);
      display: flex;
      flex-direction: column;
      gap: var(--sp-3);
    }
    .ps-card:hover {
      border-color: var(--cyan-400);
      box-shadow: 0 6px 20px rgba(0, 212, 245, 0.1);
    }
    .ps-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: var(--sp-3);
      flex-wrap: wrap;
    }
    .ps-code-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      font-weight: 700;
      background: rgba(0, 212, 245, 0.1);
      color: var(--cyan-400);
      padding: 4px 10px;
      border-radius: var(--r-sm);
      border: 1px solid rgba(0, 212, 245, 0.25);
    }
    .ps-category-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: var(--r-sm);
      text-transform: uppercase;
    }
    .ps-category-badge.software {
      background: rgba(0, 212, 245, 0.1);
      color: var(--cyan-400);
      border: 1px solid var(--cyan-400);
    }
    .ps-category-badge.hardware {
      background: rgba(245, 166, 35, 0.1);
      color: var(--gold-400);
      border: 1px solid var(--gold-400);
    }
    .ps-title {
      font-family: 'Exo 2', sans-serif;
      font-size: 18px;
      font-weight: 700;
      color: #fff;
      line-height: 1.35;
    }
    .ps-meta-row {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-4);
      font-size: 13px;
      color: var(--neutral-700);
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: var(--sp-3);
    }
    .ps-meta-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .ps-meta-item i {
      color: var(--cyan-400);
    }
    .ps-details-toggle {
      background: none;
      border: none;
      color: var(--cyan-400);
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 0;
      text-align: left;
    }
    .ps-details-toggle:hover {
      text-decoration: underline;
    }
    .ps-details-body {
      display: none;
      font-size: 13.5px;
      line-height: 1.65;
      color: var(--neutral-800);
      background: var(--neutral-100);
      border-radius: var(--r-md);
      padding: var(--sp-4);
      border: 1px solid var(--border-subtle);
      white-space: pre-line;
    }
    .ps-details-body.open {
      display: block;
    }
  
    /* 3-SECOND PROFIT / DWELL-TIME DOWNLOAD MODAL */
    .download-modal-overlay {
      position: fixed;
      top: 0; left: 0;
      width: 100vw; height: 100vh;
      background: rgba(8, 12, 24, 0.88);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      z-index: 10000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--sp-4);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }
    .download-modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }
    .download-modal-card {
      background: var(--bg-surface);
      border: 1.5px solid rgba(0, 212, 245, 0.35);
      border-radius: var(--r-xl);
      max-width: 540px;
      width: 100%;
      padding: var(--sp-6);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.75), 0 0 35px rgba(0, 212, 245, 0.18);
      transform: translateY(20px);
      transition: transform 0.25s ease;
      display: flex;
      flex-direction: column;
      gap: var(--sp-4);
    }
    .download-modal-overlay.active .download-modal-card {
      transform: translateY(0);
    }
    .modal-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .modal-server-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 700;
      color: var(--cyan-400);
      background: rgba(0, 212, 245, 0.1);
      border: 1px solid rgba(0, 212, 245, 0.3);
      padding: 4px 12px;
      border-radius: 20px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      letter-spacing: 0.5px;
    }
    .modal-close-btn {
      background: none;
      border: none;
      color: var(--neutral-600);
      font-size: 26px;
      cursor: pointer;
      line-height: 1;
      padding: 4px 8px;
      transition: color 0.2s ease;
    }
    .modal-close-btn:hover {
      color: #fff;
    }
    .modal-file-box {
      display: flex;
      align-items: center;
      gap: 16px;
      background: var(--neutral-100);
      border: 1px solid var(--border-soft);
      padding: 14px 16px;
      border-radius: var(--r-lg);
    }
    .modal-file-icon {
      font-size: 32px;
      color: var(--gold-400);
      background: rgba(245, 166, 35, 0.12);
      border: 1px solid rgba(245, 166, 35, 0.35);
      width: 52px; height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--r-md);
      flex-shrink: 0;
    }
    .modal-file-info {
      flex: 1;
      min-width: 0;
    }
    .modal-file-name {
      font-family: 'Exo 2', sans-serif;
      font-size: 15px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 3px;
      line-height: 1.3;
      word-break: break-word;
    }
    .modal-file-meta {
      font-size: 12px;
      color: var(--neutral-700);
      font-family: 'DM Sans', sans-serif;
    }
    .modal-timer-section {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .timer-headline {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'Exo 2', sans-serif;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--neutral-800);
    }
    .timer-sec-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      font-weight: 700;
      color: var(--gold-400);
      background: rgba(245, 166, 35, 0.15);
      border: 1px solid rgba(245, 166, 35, 0.35);
      padding: 2px 10px;
      border-radius: 4px;
    }
    .modal-progress-bar-wrap {
      width: 100%;
      height: 8px;
      background: var(--neutral-200);
      border-radius: 4px;
      overflow: hidden;
    }
    .modal-progress-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--cyan-400), var(--gold-400));
      transition: width 0.1s linear;
    }
    .modal-monetization-card {
      background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(20, 30, 60, 0.9) 100%);
      border: 1px solid rgba(245, 166, 35, 0.3);
      border-radius: var(--r-lg);
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .ad-sponsor-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 700;
      color: var(--gold-400);
      letter-spacing: 0.5px;
    }
    .ad-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 13.5px;
      font-weight: 700;
      color: #fff;
    }
    .ad-desc {
      font-size: 12px;
      color: var(--neutral-700);
      line-height: 1.45;
    }
    .btn-modal-sponsor {
      align-self: flex-start;
      margin-top: 4px;
      background: #ff0000;
      color: #fff;
      font-family: 'DM Sans', sans-serif;
      font-size: 12px;
      font-weight: 700;
      padding: 7px 16px;
      border-radius: var(--r-sm);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: transform 0.2s, background 0.2s;
    }
    .btn-modal-sponsor:hover {
      background: #cc0000;
      transform: translateY(-1px);
    }
    .modal-action-row {
      display: flex;
      flex-direction: column;
    }
    .btn-modal-download {
      background: var(--cyan-400);
      color: #000;
      font-family: 'Exo 2', sans-serif;
      font-size: 14.5px;
      font-weight: 700;
      padding: 12px 20px;
      border-radius: var(--r-md);
      text-align: center;
      text-decoration: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: var(--trans-default);
      border: none;
    }
    .btn-modal-download.disabled {
      background: var(--neutral-300);
      color: var(--neutral-700);
      cursor: not-allowed;
    }
    .btn-modal-download.ready {
      background: #10b981;
      color: #fff;
      box-shadow: 0 0 18px rgba(16, 185, 129, 0.45);
    }
    .modal-subtext {
      font-size: 11.5px;
      color: var(--neutral-600);
      text-align: center;
      font-family: 'JetBrains Mono', monospace;
    }
  </style>

</head>
<body>
  <!-- NAVBAR -->
  <nav class="navbar" id="navbar">
    <div class="nav-container">
      <a href="/" class="logo-link" id="nav-logo" aria-label="BlinkNBuild Homepage">
